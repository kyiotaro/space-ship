/* Skill Tree Graph View Styles */

/* GraphView background */
GridBackground {
    --grid-background-color: #1E1E1E;
    --line-color: rgba(255, 255, 255, 0.05);
    --thick-line-color: rgba(255, 255, 255, 0.1);
    --spacing: 20;
}

/* Node base styles */
.node {
    min-width: 200px;
    max-width: 300px;
    background-color: #2B2B2B;
    border-color: #4A4A4A;
    border-width: 1px;
    border-radius: 8px;
}

.node:selected {
    border-color: #44C0E7;
    border-width: 2px;
}

.node:hover {
    border-color: #5A5A5A;
}

/* Node title */
#title {
    background-color: #3A3A3A;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    padding: 8px;
    font-size: 14px;
    -unity-font-style: bold;
}

#title-label {
    color: #FFFFFF;
}

/* Node type label */
.node-type-label {
    font-size: 9px;
    color: #AAAAAA;
    padding: 2px 4px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 3px;
    margin-left: 4px;
}

/* Node icon */
.node-icon-container {
    padding: 8px;
    align-items: center;
    justify-content: center;
}

.node-icon {
    width: 48px;
    height: 48px;
    align-self: center;
}

/* Node info */
.node-info-container {
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.2);
}

.node-description {
    font-size: 11px;
    color: #CCCCCC;
    white-space: normal;
    margin-bottom: 4px;
}

.node-stat {
    font-size: 10px;
    color: #999999;
    margin-top: 2px;
}

/* Node edit button */
.node-edit-button {
    margin: 4px;
    padding: 4px 8px;
    background-color: #3E3E42;
    border-color: #555555;
    border-width: 1px;
    border-radius: 3px;
}

.node-edit-button:hover {
    background-color: #4E4E52;
}

/* Node type-specific styles */
.node-root {
    border-color: #FFD700;
}

.node-root #title {
    background-color: #4A4000;
}

.node-milestone {
    border-color: #FF6B6B;
}

.node-milestone #title {
    background-color: #4A1515;
}

.node-capstone {
    border-color: #9B59B6;
}

.node-capstone #title {
    background-color: #3A1A4A;
}

.node-special {
    border-color: #3498DB;
}

.node-special #title {
    background-color: #1A3A5A;
}

.node-standard {
    border-color: #4A4A4A;
}

.node-standard #title {
    background-color: #3A3A3A;
}

/* Ports */
Port {
    min-height: 16px;
    padding: 2px;
}

#connector {
    background-color: #FFFFFF;
    border-color: #4A4A4A;
    border-width: 2px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

#connector:hover {
    background-color: #44C0E7;
    border-color: #44C0E7;
}

#type {
    font-size: 10px;
    color: #AAAAAA;
}

/* Edges/Connections */
.connection-prerequisite .edge-control {
    edge-width: 2;
}

.connection-soft .edge-control {
    edge-width: 1;
}

.connection-exclusive .edge-control {
    edge-width: 3;
}

.connection-bidirectional .edge-control {
    edge-width: 2;
}

/* Connection type label */
.connection-type-label {
    font-size: 9px;
    padding: 2px 4px;
}

/* Selection */
#selection-border {
    border-color: #44C0E7;
    border-width: 2px;
}

/* Minimap (if implemented) */
#minimap {
    background-color: rgba(0, 0, 0, 0.2);
    border-color: #4A4A4A;
    border-width: 1px;
}
