.game-root {
    flex-grow: 1;
    color: rgb(238, 246, 255);
    background-color: transparent;
}

.home-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    color: rgb(238, 246, 255);
    background-color: rgba(4, 9, 20, 0.62);
}

.home-card {
    width: 580px;
    padding: 48px;
    align-items: center;
    background-color: rgba(8, 18, 38, 0.92);
    border-top-width: 3px;
    border-top-color: rgb(77, 224, 208);
}

.home-kicker {
    color: rgb(77, 224, 208);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.home-title {
    margin-top: 8px;
    color: rgb(241, 247, 255);
    font-size: 42px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.home-subtitle {
    margin-top: 12px;
    margin-bottom: 25px;
    color: rgb(156, 177, 200);
    font-size: 12px;
    letter-spacing: 1px;
}

.home-play {
    width: 230px;
}

.home-controls {
    margin-top: 27px;
    color: rgb(113, 137, 163);
    font-size: 9px;
    letter-spacing: 1px;
}

.hud {
    flex-grow: 1;
    justify-content: space-between;
    padding: 22px 28px;
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.brand {
    color: rgb(239, 248, 255);
    font-size: 23px;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.level-label {
    margin-top: 5px;
    color: rgb(77, 224, 208);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.top-stats {
    flex-direction: row;
    align-items: center;
}

.stat-chip {
    min-width: 88px;
    margin-left: 9px;
    padding: 8px 12px;
    background-color: rgba(8, 18, 38, 0.82);
    border-left-width: 2px;
    border-left-color: rgb(58, 144, 185);
}

.stat-caption,
.section-caption {
    color: rgb(145, 168, 192);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1.4px;
}

.stat-value {
    margin-top: 3px;
    color: rgb(243, 248, 255);
    font-size: 17px;
    -unity-font-style: bold;
}

.accent,
.currency-label {
    color: rgb(77, 224, 208);
}

.icon-button {
    width: 42px;
    height: 42px;
    margin-left: 12px;
    color: rgb(239, 248, 255);
    background-color: rgba(20, 43, 69, 0.92);
    border-width: 1px;
    border-color: rgb(58, 144, 185);
    font-size: 20px;
    -unity-font-style: bold;
}

.shop-open-button {
    min-width: 90px;
    height: 42px;
    margin-left: 12px;
    color: rgb(239, 248, 255);
    background-color: rgb(23, 111, 131);
    border-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.shop-open-button:hover,
.shop-buy-button:hover {
    background-color: rgb(35, 141, 160);
}

.shop-dialog {
    width: 1060px;
    padding: 32px;
}

.shop-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.shop-title {
    -unity-text-align: upper-left;
}

.shop-subtitle {
    -unity-text-align: upper-left;
}

.shop-balance {
    min-width: 150px;
    padding: 10px 14px;
    background-color: rgb(20, 43, 69);
    border-left-width: 2px;
    border-left-color: rgb(77, 224, 208);
}

.shop-cards {
    flex-direction: row;
    margin-left: -8px;
    margin-right: -8px;
}

.shop-card {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 255px;
    margin: 8px;
    padding: 18px;
    background-color: rgb(17, 31, 51);
    border-top-width: 2px;
    border-top-color: rgb(58, 144, 185);
}

.shop-card-category {
    color: rgb(77, 224, 208);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.shop-card-title {
    margin-top: 12px;
    color: rgb(241, 247, 255);
    font-size: 20px;
    -unity-font-style: bold;
}

.shop-card-description {
    flex-grow: 1;
    margin-top: 8px;
    color: rgb(156, 177, 200);
    font-size: 13px;
    white-space: normal;
}

.shop-card-bonus {
    margin-top: 16px;
    color: rgb(77, 224, 208);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.shop-card-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgb(36, 55, 77);
}

.shop-card-price {
    color: rgb(243, 248, 255);
    font-size: 12px;
    -unity-font-style: bold;
}

.shop-buy-button {
    min-width: 68px;
    min-height: 34px;
    color: rgb(244, 251, 255);
    background-color: rgb(23, 111, 131);
    border-width: 0;
    font-size: 12px;
    -unity-font-style: bold;
}

.shop-buy-button:disabled {
    color: rgb(113, 137, 163);
    background-color: rgb(38, 55, 75);
}

.shop-close-button {
    align-self: flex-end;
    min-width: 210px;
    margin-top: 18px;
}

.lower-hud {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.status-card,
.minimap-panel {
    padding: 13px 15px;
    background-color: rgba(8, 18, 38, 0.86);
    border-left-width: 2px;
    border-left-color: rgb(58, 144, 185);
}

.status-card {
    width: 280px;
}

.health-bar {
    height: 13px;
    margin-top: 8px;
    margin-bottom: 12px;
    --unity-progress-bar-background: rgb(23, 40, 59);
    --unity-progress-bar-color: rgb(41, 139, 185);
    -unity-background-image-tint-color: rgb(245, 0, 0);
    white-space: nowrap;
    color: rgb(0, 0, 0);
    -unity-text-outline-color: rgb(0, 0, 0);
    background-image: none;
    background-color: rgb(200, 27, 27);
    border-left-width: 0;
}

.exp-row {
    flex-direction: row;
    align-items: center;
}

.exp-bar {
    flex-grow: 1;
    height: 7px;
    margin-left: 12px;
    --unity-progress-bar-background: rgb(23, 40, 59);
    --unity-progress-bar-color: rgb(110, 168, 255);
}

.ammo-label {
    margin-top: 11px;
    color: rgb(230, 240, 252);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.minimap-panel {
    width: 170px;
}

.minimap-image {
    width: 140px;
    height: 140px;
    margin-top: 8px;
    align-self: center;
    background-color: rgb(9, 19, 33);
    border-width: 1px;
    border-color: rgb(58, 144, 185);
}

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    justify-content: center;
    align-items: center;
    background-color: rgba(4, 9, 20, 0.78);
}

.dialog {
    width: 460px;
    padding: 26px 30px;
    background-color: rgb(12, 25, 43);
    border-top-width: 3px;
    border-top-color: rgb(77, 224, 208);
}

.stats-dialog {
    width: 560px;
}

.compact-dialog {
    width: 390px;
    align-items: stretch;
}

.dialog-title {
    color: rgb(241, 247, 255);
    font-size: 25px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.danger-title {
    color: rgb(255, 106, 127);
}

.dialog-subtitle {
    margin-top: 7px;
    margin-bottom: 20px;
    color: rgb(156, 177, 200);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.currency-label {
    margin-bottom: 14px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.stats-list {
    margin-bottom: 18px;
}

.stat-row {
    min-height: 48px;
    flex-direction: row;
    align-items: center;
    padding: 5px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(36, 55, 77);
}

.row-label {
    flex-grow: 1;
    color: rgb(220, 232, 246);
    font-size: 14px;
}

.row-value {
    min-width: 76px;
    margin-right: 10px;
    color: rgb(77, 224, 208);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.primary-button,
.secondary-button,
.small-button {
    min-height: 42px;
    margin-top: 7px;
    color: rgb(244, 251, 255);
    background-color: rgb(23, 111, 131);
    border-width: 0;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.secondary-button {
    background-color: rgb(27, 43, 64);
}

.small-button {
    min-width: 130px;
    min-height: 34px;
    margin-top: 0;
    font-size: 10px;
}

.primary-button:hover,
.small-button:hover,
.icon-button:hover {
    background-color: rgb(35, 141, 160);
}

.secondary-button:hover {
    background-color: rgb(42, 64, 91);
}

.unity-progress-bar {
    background-color: rgb(255, 13, 0);
    -unity-background-image-tint-color: rgb(243, 0, 0);
}
