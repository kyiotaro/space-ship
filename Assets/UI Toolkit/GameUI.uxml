<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/GameUI.uss?fileID=7433441132597879392&amp;guid=91ca527b9c9b4b55a5d514c77c660f3d&amp;type=3#GameUI"/>
    <ui:VisualElement name="game-root" class="game-root">
        <ui:VisualElement name="shop-overlay" class="overlay" style="visibility: visible; opacity: 1; display: none;">
            <ui:VisualElement class="dialog shop-dialog" style="visibility: visible; height: 560px; width: 694px;">
                <ui:VisualElement name="VisualElement" class="shop-header">
                    <ui:VisualElement>
                        <ui:Label text="SHOP UPGRADES" parse-escape-sequences="true" class="dialog-title shop-title"/>
                        <ui:Label text="Choose upgrades for your next run." class="dialog-subtitle shop-subtitle"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="shop-balance">
                        <ui:Label text="AVAILABLE CREDITS" class="stat-caption"/>
                        <ui:Label name="shop-credits" text="0" class="stat-value accent"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="shop-cards">
                    <ui:VisualElement class="shop-card">
                        <ui:Label text="HULL" class="shop-card-category"/>
                        <ui:Label text="Reinforced Hull" class="shop-card-title"/>
                        <ui:Label text="Increase your maximum health and stay in the fight longer." class="shop-card-description"/>
                        <ui:Label text="+25 MAX HEALTH" class="shop-card-bonus"/>
                        <ui:VisualElement class="shop-card-footer">
                            <ui:Label text="250 CREDITS" class="shop-card-price"/>
                            <ui:Button text="BUY" enabled="false" class="shop-buy-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="shop-card">
                        <ui:Label text="WEAPONS" class="shop-card-category"/>
                        <ui:Label text="Pulse Amplifier" class="shop-card-title"/>
                        <ui:Label text="Boost weapon output to take down threats faster." class="shop-card-description"/>
                        <ui:Label text="+10 ATTACK" class="shop-card-bonus"/>
                        <ui:VisualElement class="shop-card-footer">
                            <ui:Label text="100 CREDITS" class="shop-card-price"/>
                            <ui:Button text="BUY" enabled="false" class="shop-buy-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="shop-card">
                        <ui:Label text="DEFENSE" class="shop-card-category"/>
                        <ui:Label text="Shield Plating" class="shop-card-title"/>
                        <ui:Label text="Strengthen your shields against incoming damage." class="shop-card-description"/>
                        <ui:Label text="+1 DEFENSE" class="shop-card-bonus"/>
                        <ui:VisualElement class="shop-card-footer">
                            <ui:Label text="150 CREDITS" class="shop-card-price"/>
                            <ui:Button text="BUY" enabled="false" class="shop-buy-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="close-shop-button" text="BACK TO FLIGHT" class="primary-button shop-close-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="stats-overlay" class="overlay">
            <ui:VisualElement class="dialog stats-dialog">
                <ui:Label text="PILOT STATUS" class="dialog-title"/>
                <ui:Label text="Upgrade your ship systems" class="dialog-subtitle"/>
                <ui:Label name="upgrade-points" text="Upgrade points: 0" class="currency-label"/>
                <ui:Label name="stats-credits" text="Credits: 0" class="currency-label"/>
                <ui:VisualElement class="stats-list">
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="Hull" class="row-label"/>
                        <ui:Label name="stats-health" text="100 / 100" class="row-value"/>
                        <ui:Button name="upgrade-health" text="+ HULL" class="small-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="Attack" class="row-label"/>
                        <ui:Label name="stats-attack" text="10" class="row-value"/>
                        <ui:Button name="upgrade-attack" text="+ ATTACK (100 CREDITS)" class="small-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="Defense" class="row-label"/>
                        <ui:Label name="stats-defense" text="5" class="row-value"/>
                        <ui:Button name="upgrade-defense" text="+ DEFENSE" class="small-button"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="stat-row">
                        <ui:Label text="Speed" class="row-label"/>
                        <ui:Label name="stats-speed" text="5" class="row-value"/>
                        <ui:Button name="upgrade-speed" text="+ SPEED" class="small-button"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="close-stats-button" text="BACK TO FLIGHT" class="primary-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause-overlay" class="overlay">
            <ui:VisualElement class="dialog compact-dialog">
                <ui:Label text="FLIGHT PAUSED" class="dialog-title"/>
                <ui:Label text="Take a moment, pilot." class="dialog-subtitle"/>
                <ui:Button name="resume-button" text="RESUME" class="primary-button"/>
                <ui:Button name="restart-button" text="RESTART RUN" class="secondary-button"/>
                <ui:Button name="home-button" text="MAIN MENU" class="secondary-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="game-over-overlay" class="overlay">
            <ui:VisualElement class="dialog compact-dialog">
                <ui:Label text="SHIP LOST" class="dialog-title danger-title"/>
                <ui:Label text="Your run has ended." class="dialog-subtitle"/>
                <ui:Button name="game-over-restart-button" text="TRY AGAIN" class="primary-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="hud" class="hud">
            <ui:VisualElement name="VisualElement" class="top-bar">
                <ui:VisualElement class="top-stats">
                    <ui:VisualElement class="stat-chip">
                        <ui:Label text="CREDITS" class="stat-caption"/>
                        <ui:Label name="points-value" text="0" class="stat-value accent"/>
                    </ui:VisualElement>
                    <ui:Button name="open-shop-button" text="SHOP" class="shop-open-button"/>
                    <ui:Button name="pause-button" text="II" class="icon-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="lower-hud" style="width: 1867px; align-items: center; justify-content: space-between; align-self: center; flex-direction: row; bottom: 10px;">
                <ui:VisualElement name="VisualElement" class="status-card" style="width: 525px; justify-content: center; align-items: stretch; height: 134px;">
                    <ui:Label text="Health Point" class="section-caption"/>
                    <ui:ProgressBar name="health-bar" class="health-bar" style="width: 483px; align-items: stretch; justify-content: space-around; flex-direction: column; align-self: stretch; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; -unity-text-auto-size: none; background-color: rgb(0, 0, 0);"/>
                    <ui:Label name="ammo-value" text="AMMO  6 / 6" class="ammo-label" style="font-size: 12px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="minimap-panel" class="minimap-panel">
                    <ui:Label text="SECTOR SCAN" class="section-caption"/>
                    <ui:Image name="minimap-image" class="minimap-image"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
