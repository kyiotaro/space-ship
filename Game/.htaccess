# This .htaccess file is used to configure the Apache web server to correctly serve 
# Unity WebGL builds with Brotli compression.

<IfModule mod_mime.c>
  # Mapping .br extension to Brotli encoding
  AddEncoding br .br

  # Correct MIME types for Unity WebGL files
  AddType application/octet-stream .data.br
  AddType application/wasm .wasm.br
  AddType application/javascript .js.br
  AddType application/octet-stream .symbols.json.br
</IfModule>

<IfModule mod_headers.c>
  # Explicitly set Content-Encoding header for .br files
  <FilesMatch "\.br$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>
